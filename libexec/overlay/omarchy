#!/bin/bash
# Let the checkout router resolve ALL spellings, aliases, metadata and help.
# Only intercept its final exec, so an absolute bin path cannot bypass a nest
# override. Do not reimplement the router's argument parsing here.
[[ -n ${OMARCHY_PATH:-} && -f $OMARCHY_PATH/bin/omarchy ]] || {
  echo "omarchy (omadev): checkout router not found" >&2; exit 1;
}
omadev_overlay=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
exec() {
  if [[ ${1:-} == "$OMARCHY_PATH/bin/"* && -x $omadev_overlay/${1##*/} ]]; then
    builtin exec "$omadev_overlay/${1##*/}" "${@:2}"
  else
    builtin exec "$@"
  fi
}
builtin source "$OMARCHY_PATH/bin/omarchy" "$@"
