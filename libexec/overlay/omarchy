#!/bin/bash
# Nested router shim: `omarchy restart shell` must only restart the shell on
# this display. Everything else goes to the real router.
overlay=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
if [[ ${1:-} == restart && ${2:-} == shell ]]; then
  exec "$overlay/omarchy-restart-shell" "${@:3}"
fi
clean_path=$(tr ':' '\n' <<<"$PATH" | grep -vxF "$overlay" | paste -sd:)
real=$(PATH=$clean_path command -v omarchy) || { echo "omarchy: real router not found" >&2; exit 1; }
exec "$real" "$@"
