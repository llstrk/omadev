post_install() {
  cat <<'MSG'
omadev: configure host bindings and register this backend as your user: omadev setup
Install the optional widget separately:
  omarchy plugin add https://github.com/llstrk/omadev --enable
MSG
}

post_upgrade() {
  cat <<'MSG'
omadev: refresh host bindings and backend registration: omadev setup
The git-managed widget updates independently: omarchy plugin update dry.omadev
MSG
}
